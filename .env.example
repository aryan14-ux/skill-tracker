# Vercel: add values in Project Settings > Environment Variables.
# Local backend: copy backend/.env.example to backend/.env instead.
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=7d

# Leave DB_HOST unset for temporary demo mode.
# For persistence, configure an initialized hosted MySQL database:
# DB_HOST=your-database-host
# DB_PORT=3306
# DB_NAME=skilltrack_db
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_SSL=true
# DB_SSL_CA=provider-ca-certificate-if-required

# Leave VITE_API_URL unset on Vercel to use same-origin /api requests.

